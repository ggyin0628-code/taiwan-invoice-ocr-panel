# Local-first OCR mode. Does not call Google Vision or OpenAI Vision.
OCR_PROVIDER=hybrid
AI_VISION_PROVIDER=none

# Local fallback OCR.
LOCAL_OCR_ENGINE=tesseract

# PaddleOCR Python service.
PADDLE_OCR_ENABLED=true
PADDLE_OCR_SERVICE_URL=http://127.0.0.1:8765

# Ollama assists low-confidence fields only.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
